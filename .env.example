# WhatsApp Cloud API (Meta) - usado para crear el primer cliente al arrancar
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=valeria_webhook_secret

# OpenAI (compartida entre todos los clientes)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Primer cliente (se crea automaticamente en la BD si no existe)
BUSINESS_NAME=Seguros Mexicali Plus
BUSINESS_CONTEXT_FILE=app/contexts/seguros_mexicali_plus.txt
ASSISTANT_OWNER_NAME=Gilberto
PERSONALITY_LEVEL=4
MAX_HISTORY_MESSAGES=12

# Admin API para dar de alta mas clientes
ADMIN_API_KEY=valeria_admin_secret
SESSION_SECRET_KEY=valeria-session-secret-change-me

# Server
PORT=8000
DATABASE_URL=sqlite:///./valeria.db
PUBLIC_BASE_URL=https://valeria-production-3bcc.up.railway.app

# Google Calendar OAuth (Cloud Console → APIs → Google Calendar API + OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exacto con el redirect de Google Cloud Console
GOOGLE_REDIRECT_URI=https://valeria-production-3bcc.up.railway.app/panel/google/callback
